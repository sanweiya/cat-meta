[Desktop Entry]
Type=Application
Version=1.0
Name=Cat Meta
Name[zh_CN]=Cat Meta 代理客户端
GenericName=Network Proxy Client
GenericName[zh_CN]=网络代理客户端
Comment=Native mihomo proxy client for Linux Mint
Comment[zh_CN]=为 Linux Mint 打造的原生 mihomo 代理客户端
Exec=cat-meta %U
Icon=cat-meta
Terminal=false
Categories=Network;
Keywords=proxy;clash;mihomo;vpn;订阅;代理;
StartupNotify=true
StartupWMClass=CatMeta
X-GNOME-UsesNotifications=true
MimeType=application/x-yaml;text/yaml;
Actions=OpenSettings;

[Desktop Action OpenSettings]
Name=打开设置
Name[zh_CN]=打开设置
Exec=cat-meta --page=settings
